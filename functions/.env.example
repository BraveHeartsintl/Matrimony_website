# Copy to `functions/.env.<project-id>` (or `.env` for all environments) for
# local `firebase emulators:start` runs. These are Firebase Functions "params"
# (firebase-functions/params) — safe to keep as plain strings, NOT secrets.
#
# In deployed environments set them the same way, e.g.:
#   firebase deploy --only functions
# (the CLI will prompt for any params without a default), or predefine with:
#   firebase functions:config:env:set APP_URL="https://ukmatrimony.co.uk"

# Public base URL the browser is redirected back to after Stripe Checkout /
# the Billing Portal, and the origin used in branded verification emails.
# Must match the deployed app origin (and be in Firebase Auth authorized domains).
APP_URL=http://localhost:3000

# Branded verification emails (UK Indian Matrimony mailbox, not Firebase).
# SMTP_PASS is a secret — do not put it here. Use:
#   firebase functions:secrets:set SMTP_PASS
# or for the emulator, functions/.secret.local:
#   SMTP_PASS=your-mailbox-password
SMTP_HOST=smtp.ionos.co.uk
SMTP_PORT=587
SMTP_USER=hello@ukmatrimony.co.uk
MAIL_FROM_NAME=UK Indian Matrimony
MAIL_FROM_ADDRESS=hello@ukmatrimony.co.uk

# Stripe Price IDs (test mode) — create these Products/Prices in the Stripe
# Dashboard first, then paste the resulting `price_...` IDs here.
STRIPE_PRICE_SILVER_MONTHLY=
STRIPE_PRICE_SILVER_YEARLY=
STRIPE_PRICE_GOLD_MONTHLY=
STRIPE_PRICE_GOLD_YEARLY=

# Veriff API base URL (from Integration → API Keys). Not a secret.
# Example sandbox: https://stationapi.veriff.com
VERIFF_BASE_URL=https://stationapi.veriff.com

# --- Secrets (do NOT put these here) ---
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, VERIFF_API_KEY, VERIFF_SHARED_SECRET,
# and SMTP_PASS are `defineSecret()` values.
# For the emulator, put them in `functions/.secret.local` (gitignored):
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   VERIFF_API_KEY=...
#   VERIFF_SHARED_SECRET=...
#   SMTP_PASS=...
# For deployed functions, set them in Secret Manager instead:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#   firebase functions:secrets:set VERIFF_API_KEY
#   firebase functions:secrets:set VERIFF_SHARED_SECRET
#   firebase functions:secrets:set SMTP_PASS
#
# After deploying, set Veriff Decision webhook URL to:
#   https://us-central1-<PROJECT_ID>.cloudfunctions.net/veriffWebhook
